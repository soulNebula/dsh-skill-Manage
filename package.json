{
  "name": "dsh-skill-manage",
  "version": "0.2.0",
  "description": "Skill 管理 for DeepSeek Harness: import skill folders, register them as live DSH skills and slash commands, browse and edit their files.",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "python/*.py",
    "docs/*.md",
    "cordis.patch.yml",
    ".framework.json",
    "config.example.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "build:local": "node scripts/build-local.mjs",
    "import-skill": "node scripts/import-skill.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "tsdown": "0.22.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
